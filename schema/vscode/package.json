{
  "name": "jsonschema",
  "displayName": "JSON Schema Diagram",
  "description": "Explore JSON Schema and OpenAPI JSON in an offline interactive diagram.",
  "version": "0.1.0",
  "publisher": "eelcoh",
  "license": "MIT",
  "repository": "https://github.com/eelcoh/eelcoh.github.io",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization"],
  "main": "./extension.cjs",
  "files": ["extension.cjs", "shared-extension.cjs", "renderer.cjs", "LICENSE"],
  "contributes": {
    "commands": [
      {
        "command": "jsonschema.openPreview",
        "title": "JSON Schema: Open Diagram to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "jsonschema.selectTheme",
        "title": "JSON Schema: Choose Theme for This File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jsonschema.openPreview",
          "when": "editorLangId == json || editorLangId == jsonc",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "JSON Schema Diagram",
      "properties": {
        "jsonschema.theme": {
          "type": "string",
          "enum": ["classic", "monochrome", "inverse-monochrome", "dark", "high-contrast-black"],
          "default": "classic",
          "description": "Default theme for previews without a file-specific override."
        }
      }
    }
  }
}
