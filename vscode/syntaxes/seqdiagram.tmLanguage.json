{
  "scopeName": "source.seqdiagram",
  "patterns": [
    {
      "match": "^(sequence)( +)([A-Za-z0-9]+)",
      "captures": {
        "1": { "name": "keyword.declaration.seqdiagram" },
        "3": { "name": "entity.name.type.seqdiagram" }
      }
    },
    {
      "match": "^[ \\t]+([A-Za-z0-9]+)",
      "captures": { "1": { "name": "entity.name.type.seqdiagram" } }
    },
    {
      "match": "(\\[)( *)(async)( *)(\\])",
      "captures": {
        "1": { "name": "punctuation.section.brackets.begin.seqdiagram" },
        "3": { "name": "storage.modifier.seqdiagram" },
        "5": { "name": "punctuation.section.brackets.end.seqdiagram" }
      }
    },
    {
      "match": "(:)(.*)$",
      "captures": {
        "1": { "name": "punctuation.separator.seqdiagram" },
        "2": { "name": "string.unquoted.seqdiagram" }
      }
    }
  ]
}
