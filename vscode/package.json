{
  "name": "seqdiagram",
  "displayName": "Sequence Diagram",
  "description": "Edit indented sequence diagrams with an offline Elm preview.",
  "version": "0.2.0",
  "publisher": "eelcoh",
  "license": "MIT",
  "repository": "https://github.com/eelcoh/eelcoh.github.io",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "seqdiagram",
        "aliases": [
          "Sequence Diagram",
          "seqdiagram"
        ],
        "extensions": [
          ".seq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seqdiagram",
        "scopeName": "source.seqdiagram",
        "path": "./syntaxes/seqdiagram.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "seqdiagram.openPreview",
        "title": "Sequence Diagram: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "seqdiagram.selectTheme",
        "title": "Sequence Diagram: Choose Theme for This File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "seqdiagram.openPreview",
          "when": "editorLangId == seqdiagram",
          "group": "navigation"
        },
        {
          "command": "seqdiagram.selectTheme",
          "when": "editorLangId == seqdiagram"
        }
      ]
    },
    "configurationDefaults": {
      "[seqdiagram]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "configuration": {
      "title": "Sequence Diagram",
      "properties": {
        "seqdiagram.theme": {
          "type": "string",
          "enum": [
            "classic",
            "monochrome",
            "inverse-monochrome",
            "dark",
            "high-contrast-black"
          ],
          "default": "classic",
          "description": "Default preview theme for diagrams without a file-specific theme."
        },
        "seqdiagram.showReturns": {
          "type": "boolean",
          "default": true,
          "description": "Show return arrows in the live preview."
        }
      }
    }
  }
}
